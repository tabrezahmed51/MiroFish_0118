# Smart-Talk Chatbot Configuration
# Qwen AI Model Settings for Indian-Style Open Discussion Platform

# Qwen AI API Configuration
QWEN_API_KEY=your_qwen_api_key_here
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_MODEL_NAME=qwen-plus

# Alternative Qwen Models:
# - qwen-turbo: Fast and cost-effective
# - qwen-plus: Balanced performance (default)
# - qwen-max: Maximum capability
# - qwen-long: Extended context support

# You can also use the existing LLM configuration as fallback
# The chatbot will use LLM_API_KEY if QWEN_API_KEY is not set
